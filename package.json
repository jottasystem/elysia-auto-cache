{
  "name": "@jottasystem/elysia-auto-cache",
  "version": "0.1.0",
  "description": "Declarative response cache for Elysia with automatic tag invalidation over Redis",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./core": {
      "types": "./lib/core/index.d.ts",
      "default": "./lib/core/index.js"
    },
    "./redis": {
      "types": "./lib/redis/index.d.ts",
      "default": "./lib/redis/index.js"
    }
  },
  "files": [
    "lib"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "clean": "rimraf lib",
    "build": "npm run clean && tsc",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "typecheck:spec": "tsc --noEmit -p tsconfig.spec.json",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "lint": "eslint src test",
    "test": "bun test",
    "prepare": "npm run build",
    "prepublishOnly": "npm run lint && npm run typecheck && npm test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jottasystem/elysia-auto-cache.git"
  },
  "license": "MIT",
  "peerDependencies": {
    "elysia": ">=1.3",
    "ioredis": ">=5.0.0"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@types/node": "^20.19.43",
    "elysia": "1.4.19",
    "eslint": "^9.39.5",
    "ioredis": "^5.8.2",
    "prettier": "^3.9.8",
    "rimraf": "^6.1.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.1"
  }
}
